# =======================================================
# FilmTracker - Environment Variables Template
# =======================================================
# Salin file ini menjadi .env dan isi nilainya.
# Jangan pernah commit file .env ke version control!
# =======================================================

# Dapatkan API Key kamu dari: https://www.themoviedb.org/settings/api
VITE_TMDB_API_KEY=your_tmdb_api_key_here

# Base URL untuk TMDB API (tidak perlu diubah)
VITE_TMDB_BASE_URL=https://api.themoviedb.org/3

# Base URL untuk gambar poster TMDB (tidak perlu diubah)
VITE_TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p
